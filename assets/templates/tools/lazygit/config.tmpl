# Generated by theme-engine — do not edit manually.
#
# Colors are resolved from the active theme's semantic palette. lazygit draws
# the selected line with defaultFgColor over selectedLineBgColor, so the
# selection background is layer.surface_overlay to stay readable.
gui:
  theme:
    activeBorderColor:
      - "{{ .Palette.AccentPrimary }}"
    inactiveBorderColor:
      - "{{ .Palette.BorderDefault }}"
    searchingActiveBorderColor:
      - "{{ .Palette.SyntaxOrange }}"
    optionsTextColor:
      - "{{ .Palette.AccentPrimary }}"
    selectedLineBgColor:
      - "{{ .Palette.LayerSurfaceOverlay }}"
    cherryPickedCommitFgColor:
      - "{{ .Palette.AccentPrimary }}"
    cherryPickedCommitBgColor:
      - "{{ .Palette.SyntaxTeal }}"
    markedBaseCommitFgColor:
      - "{{ .Palette.AccentPrimary }}"
    markedBaseCommitBgColor:
      - "{{ .Palette.SyntaxOrange }}"
    unstagedChangesColor:
      - "{{ .Palette.StatusError }}"
    defaultFgColor:
      - "{{ .Palette.TextPrimary }}"
