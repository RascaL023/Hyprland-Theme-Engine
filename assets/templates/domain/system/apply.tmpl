#!/usr/bin/env bash
# Auto-generated by Theme-Engine

# GTK System Fonts
dconf write /org/gnome/desktop/interface/font-name "'{{ .Theme.Theme.Fonts.System.Family }} {{ .Theme.Theme.Fonts.System.Size }}'"
dconf write /org/gnome/desktop/interface/document-font-name "'{{ .Theme.Theme.Fonts.System.Family }} {{ .Theme.Theme.Fonts.System.Size }}'"
dconf write /org/gnome/desktop/interface/monospace-font-name "'{{ .Theme.Theme.Fonts.Terminal.Family }} {{ .Theme.Theme.Fonts.Terminal.Size }}'"

# Cursor Size
dconf write /org/gnome/desktop/interface/cursor-size 23

# Color Scheme
dconf write /org/gnome/desktop/interface/color-scheme "'{{ if eq .ThemeType "dark" }}prefer-dark{{ else }}prefer-light{{ end }}'"

echo "System fonts & color scheme applied via dconf."
