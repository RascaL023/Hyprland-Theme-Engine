{
  "theme": {
    "name": "sakura",
    "fonts": {
      "primary": "FiraCode Nerd Font",
      "secondary": "Maple Mono Nerd Font",
      "size": 11.5
    }
  },

  "tools": {
    "cava": {
      "gradients": [
        "$pl.extra.layer.crust",
        "$pl.extra.layer.surface",
        "$pl.extra.layer.surface_raised",
        "$pl.extra.layer.surface_overlay",
        "$pl.extra.accent.primary"
      ]
    },

    "foot": {
      "fontSize": 11.5,
      "padding": {
        "x": 14,
        "y": 8
      }
    },

    "kitty": {
      "cursorShape": "beam",
      "opacity": 0.45,
      "fontSize": 11.5,

      "tab": {
        "active": {
          "foreground": "$pl.extra.accent.primary",
          "background": "$pl.extra.layer.surface"
        },
        "inactive": {
          "foreground": "$pl.extra.text.muted",
          "background": "$pl.extra.layer.mantle"
        },

        "bar": "powerline",
        "style": "slanted"
      },

      "window": {
        "border": {
          "active": "$pl.extra.accent.primary",
          "inactive": "$pl.extra.layer.mantle",
          "width": 1
        },

        "margin": 6,
        "padding": 10
      }
    },

    "hypr": {
      "gaps": {
        "in": 2,
        "out": 6
      },

      "border": {
        "size": 2,
        "active": {
          "degree": 45,
          "primary": "$pl.extra.accent.primary",
          "secondary": "$pl.extra.accent.secondary"
        },
        "inactive": {
          "primary": "$pl.extra.layer.crust"
        }
      },

      "blur": {
        "option": true,
        "size": 6,
        "passes": 6
      },

      "rounding": 10,

      "shadow": {
        "option": true,
        "range": 8,
        "renderPower": 2,
        "color": "$pl.extra.layer.crust"
      },

      "windowRule": {
        "foot": {
          "opacity": 0.75
        }
      }
    }
  }
}
