{
  "theme": {
    "name": "harbor",
    "fonts": {
      "system": {
        "family": "Inter",
        "size": 11.0
      },
      "widget": {
        "family": "Inter",
        "size": 11.0
      },
      "terminal": {
        "family": "MapleMono NF",
        "size": 11.0
      }
    }
  },
  "tools": {
    "cava": {
      "gradients": [
        "$pl.extra.layer.crust",
        "$pl.extra.layer.surface",
        "$pl.extra.layer.surface_raised",
        "$pl.extra.accent.secondary",
        "$pl.extra.accent.primary"
      ]
    },
    "foot": {
      "padding": {
        "x": 16,
        "y": 10
      }
    },
    "kitty": {
      "cursorShape": "beam",
      "opacity": 0.72,
      "tab": {
        "active": {
          "foreground": "$pl.extra.accent.primary",
          "background": "$pl.extra.layer.surface_raised"
        },
        "inactive": {
          "foreground": "$pl.extra.text.muted",
          "background": "$pl.extra.layer.mantle"
        },
        "bar": "powerline",
        "style": "slanted"
      },
      "window": {
        "border": {
          "active": "$pl.extra.accent.primary",
          "inactive": "$pl.extra.layer.mantle",
          "width": 1
        },
        "margin": 6,
        "padding": 10
      }
    },
    "hypr": {
      "gaps": {
        "in": 2,
        "out": 6
      },
      "border": {
        "size": 2,
        "active": {
          "degree": 45,
          "primary": "$pl.extra.accent.primary",
          "secondary": "$pl.extra.accent.secondary"
        },
        "inactive": {
          "primary": "$pl.extra.layer.crust"
        }
      },
      "blur": {
        "option": true,
        "size": 6,
        "passes": 6
      },
      "rounding": 12,
      "shadow": {
        "option": true,
        "range": 10,
        "renderPower": 2,
        "color": "$pl.extra.layer.crust"
      },
      "windowRule": {
        "foot": {
          "opacity": 0.8
        }
      }
    },
    "alacritty": {
      "opacity": 0.82,
      "padding": {
        "x": 22,
        "y": 18
      },
      "cursor": {
        "style": {
          "shape": "Beam"
        }
      }
    }
  }
}
