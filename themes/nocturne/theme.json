{
  "theme": {
    "name": "nocturne",
    "fonts": {
      "primary": "ComicShannsMono Nerd Font",
      "secondary": "Iosevka Nerd Font",
      "size": 10.5
    }
  },

  "tools": {
    "cava": {
      "gradients": [
        "$pl.extra.layer.crust",
        "$pl.extra.layer.surface",
        "$pl.extra.layer.surface_raised",
        "$pl.extra.accent.secondary",
        "$pl.extra.accent.primary"
      ]
    },

    "foot": {
      "fontSize": 10.5,
      "padding": {
        "x": 20,
        "y": 14
      }
    },

    "kitty": {
      "cursorShape": "beam",
      "opacity": 0.82,
      "fontSize": 10.5,

      "tab": {
        "active": {
          "foreground": "$pl.extra.accent.primary",
          "background": "$pl.extra.layer.crust"
        },
        "inactive": {
          "foreground": "$pl.extra.text.muted",
          "background": "$pl.extra.layer.mantle"
        },

        "bar": "powerline",
        "style": "slanted"
      },

      "window": {
        "border": {
          "active": "$pl.extra.accent.primary",
          "inactive": "$pl.extra.layer.crust",

          "width": 2
        },

        "margin": 8,
        "padding": 14
      }
    },

    "hypr": {
      "gaps": {
        "in": 3,
        "out": 7
      },

      "border": {
        "size": 2,
        "active": {
          "degree": 135,
          "primary": "$pl.extra.accent.primary",
          "secondary": "$pl.extra.accent.secondary"
        },
        "inactive": {
          "primary": "$pl.extra.layer.crust"
        }
      },

      "blur": {
        "option": true,
        "size": 8,
        "passes": 4
      },

      "rounding": 14,

      "shadow": {
        "option": true,
        "range": 12,
        "renderPower": 3,
        "color": "$pl.extra.layer.crust"
      },

      "windowRule": {
        "foot": {
          "opacity": 0.7
        }
      }
    }
  }
}
