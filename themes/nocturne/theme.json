{
  "theme": {
    "name": "nocturne",
    "fonts": {
      "primary": "FiraCode Nerd Font",
      "secondary": "Maple Mono Nerd Font",
      "size": 11.5
    }
  },

  "tools": {
    "cava": {
      "gradients": [
        "$pl.extra.layer.crust",
        "$pl.extra.layer.surface",
        "$pl.extra.layer.surface_raised",
        "$pl.extra.layer.surface_overlay",
        "$pl.extra.accent.secondary"
      ]
    },

    "foot": {
      "fontSize": 11.5,
      "padding": {
        "x": 16,
        "y": 10
      }
    },

    "kitty": {
      "cursorShape": "beam",
      "opacity": 0.7,
      "fontSize": 11.5,

      "tab": {
        "active": {
          "foreground": "$pl.extra.text.secondary",
          "background": "$pl.extra.layer.surface"
        },
        "inactive": {
          "foreground": "$pl.extra.layer.surface_raised",
          "background": "$pl.extra.text.secondary"
        },

        "bar": "powerline",
        "style": "slanted"
      },

      "window": {
        "border": {
          "active": "$pl.extra.accent.primary",
          "inactive": "$pl.extra.layer.mantle",

          "width": 1
        },

        "margin": 5,
        "padding": 8
      }
    },

    "hypr": {
      "gaps": {
        "in": 1,
        "out": 5
      },

      "border": {
        "size": 2,
        "active": {
          "degree": 45,
          "primary": "$pl.extra.accent.primary",
          "secondary": "$pl.extra.accent.secondary"
        },
        "inactive": {
          "primary": "$pl.extra.layer.crust"
        }
      },

      "blur": {
        "option": true,
        "size": 4,
        "passes": 3
      },

      "rounding": 7,

      "shadow": {
        "option": true,
        "range": 6,
        "renderPower": 1,
        "color": "$pl.extra.layer.crust"
      },

      "windowRule": {
        "foot": {
          "opacity": 0.85
        }
      }
    }  
  }
}
